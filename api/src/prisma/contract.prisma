// use prisma-8

model EventStore {
  sequenceNumber Int      @id @default(autoincrement())
  id             String   @unique
  walletId       String
  amount         Float
  type           String   // CREDIT or DEBIT
  status         String   // COMPLETED or FAILED
  createdAt      TimestamptzString @default(now())

  @@index([walletId])
}
